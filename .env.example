# =================================================================
# .env.example — Hospital CRM local development
# Copy to .env (gitignored) and fill in real values for your box.
# NEVER commit a real .env file.
#
# Anything marked "LOCAL-ONLY DEFAULT" is a fallback for the compose
# file. Override these in .env before exposing the stack to anything
# other than localhost.
# =================================================================

# ----- PostgreSQL -----
POSTGRES_DB=hospital_crm
POSTGRES_USER=crm_user
# LOCAL-ONLY DEFAULT. Replace in .env before any non-local use.
POSTGRES_PASSWORD=ChangeMe-LocalOnly-NotForProd

# ----- ASP.NET Core & Security -----
ASPNETCORE_ENVIRONMENT=Development
Cors__AllowedOrigins=http://localhost:5173,http://localhost:8080,http://localhost:80

# ----- JWT (Phase 1 default; override in .env) -----
Jwt__Issuer=Hospital_CRM
Jwt__Audience=Hospital_CRM

# ----- Razorpay (Phase 1) -----
# Local defaults: empty (stub payment service used)
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=

# ----- WhatsApp (Phase 1) -----
WhatsApp__ApiUrl=
WhatsApp__AccessToken=
WhatsApp__PhoneNumberId=

# ----- Azurite (LOCAL-ONLY default account) -----
# Azurite's well-known dev account. Don't reuse in any non-local env.
AZURITE_ACCOUNT_NAME=devstoreaccount1
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLmot4ZeHOMgUm2llPREPwU9L9xCHWENR

# ----- Typesense (self-hosted search) -----
# Single source of truth — backend reads Typesense:ApiKey, frontend has no
# direct Typesense access. Use a different key per environment.
# LOCAL-ONLY DEFAULT. Replace in .env before any non-local use.
TYPESENSE_API_KEY=ChangeMe-LocalOnly-TypesenseKey
# Used by the api container to reach Typesense inside the compose network
# (override in production to your Azure Container Apps typesense FQDN).
TYPESENSE__HOST=http://typesense:8108
# Used by `docker compose` from the host (curl/UI). Don't change the port.
TYPESENSE_HOST_PORT=8108

# ----- Frontend (Vite) -----
# Public values only — no secrets.
VITE_API_BASE=http://localhost:8080
VITE_PROXY_TARGET=http://api:8080
VITE_OIDC_AUTHORITY=
VITE_CLIENT_ID=

