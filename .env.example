# =================================================================
# .env.example — Hospital CRM local development & production staging
# Copy to .env (gitignored) and fill in real values for your environment.
# NEVER commit a real .env file.
# =================================================================

# ----- Database (PostgreSQL 16+) -----
POSTGRES_DB=hospital_crm
POSTGRES_USER=crm_user
# LOCAL-ONLY DEFAULT. Replace in .env before any non-local use.
POSTGRES_PASSWORD=ChangeMe-LocalOnly-NotForProd
POSTGRES_PORT=5432

# Dedicated application runtime connection (Least Privilege: app_user)
# In production, app_user has SELECT, INSERT, UPDATE, DELETE on application tables,
# and REVOKE UPDATE, DELETE on all audit logs.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=hospital_crm;Username=postgres;Password=postgres
Hangfire__PostgreSql__Connection=Host=localhost;Port=5432;Database=hospital_crm;Username=postgres;Password=postgres

# ----- ASP.NET Core & Hosting -----
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
Cors__AllowedOrigins=http://localhost:5173,http://localhost:8080,http://localhost:80

# ----- JWT RS256 Authentication -----
Jwt__Issuer=Hospital_CRM
Jwt__Audience=Hospital_CRM
Jwt__AccessTokenExpiryMinutes=15
Jwt__RefreshTokenExpiryDays=7
Jwt__InactivityTimeoutMinutes=30
Jwt__KeyId=hospital-crm-rsa-key-1
# KeySource options: "PemFile" (disk-backed PEM) or "AzureKeyVault" (HSM/Managed Identity)
Jwt__KeySource=PemFile
Jwt__PemFilePath=./keys/jwt-private.pem

# Optional: Azure Key Vault for enterprise RS256 signing
Jwt__AzureKeyVault__Url=
Jwt__AzureKeyVault__KeyName=

# ----- Brute-Force Defense & Rate Limiting -----
Auth__MaxFailedAttempts=5
Auth__LockoutMinutes=15
RateLimiting__GlobalPermitLimit=2000
RateLimiting__AuthPermitLimit=500
RateLimiting__PrecheckPermitLimit=100

# ----- Razorpay (Phase 1 Payments) -----
# Leave empty for local development (stub payment service active)
Razorpay__KeyId=
Razorpay__KeySecret=
Razorpay__WebhookSecret=
Razorpay__ReconciliationIntervalMinutes=60

# ----- WhatsApp Business API (Phase 1 Notifications) -----
WhatsApp__ApiUrl=
WhatsApp__AccessToken=
WhatsApp__PhoneNumberId=
WhatsApp__BusinessAccountId=
WhatsApp__TemplateNamespace=

# ----- Azurite / Azure Blob Storage (Lab Uploads) -----
# Azurite's well-known dev account. In production, use real Azure Blob connection string.
AZURITE_ACCOUNT_NAME=devstoreaccount1
AZURITE_ACCOUNT_KEY=Eby8vdM02xNOcqFlqUwJPLmot4ZeHOMgUm2llPREPwU9L9xCHWENR
AzureStorage__ConnectionString=UseDevelopmentStorage=true
AzureStorage__BlobEndpoint=http://localhost:10000/devstoreaccount1
Lab__UploadDir=lab-uploads

# ----- Typesense (Self-Hosted Fast Search) -----
# Single source of truth — backend queries Typesense; frontend has no direct access.
TYPESENSE_API_KEY=ChangeMe-LocalOnly-TypesenseKey
TYPESENSE__HOST=http://localhost:8108
TYPESENSE_HOST_PORT=8108

# ----- Frontend (React 19 + Vite PWA) -----
# Public values only — no secrets.
VITE_API_BASE=http://localhost:8080
VITE_PROXY_TARGET=http://api:8080

# ----- In-House OIDC Identity Center (OpenIddict) -----
# Set authority and client ID for Single Sign-On (defaults to in-house API host + hospital-crm-pwa)
VITE_AUTH_AUTHORITY=http://localhost:8080
VITE_AUTH_CLIENT_ID=hospital-crm-pwa
VITE_AUTH_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_AUTH_SCOPE=openid profile email api roles
