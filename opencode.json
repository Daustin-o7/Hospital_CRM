{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "provider": {
    "agentrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter",
      "options": {
        "baseURL": "https://agentrouter.org/v1",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        },
        "deepseek-v4-flash": {
          "name": "DeepSeek v4 Flash",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  }
}
