{
  "$schema": "https://opencode.ai/config.json",
  "model": "agentrouter/gpt-5.6-sol",
  "plugin": [
    "@dietrichgebert/ponytail"
  ],
  "provider": {
    "agentrouter": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AgentRouter",
      "options": {
        "baseURL": "https://agentrouter.org/v1",
        "apiKey": "{env:AGENTROUTER_API_KEY}"
      },
      "models": {
        "gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-6-astra": {
          "name": "GPT-6 Astra",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  }
}
