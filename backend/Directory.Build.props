<Project>
  <!--
    Solution-wide MSBuild properties.
    NU1608 = package version outside of dependency constraint.
    This fires because Npgsql.EntityFrameworkCore.PostgreSQL 10.0.0-preview.7
    pins to EF Core preview.7 but we upgraded to the stable RTM 10.0.11.
    The packages are binary-compatible; this is a metadata-only mismatch.
    NU1903 = build-time EF Design tooling has transitive vulns (not runtime).
  -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);NU1608;NU1903</NoWarn>
  </PropertyGroup>
</Project>
